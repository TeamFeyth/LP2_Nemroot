---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}

  <!-- Open Graph / social preview (uses the same title & description above) -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta name="twitter:card" content="summary" />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <!--
    ================================================================
    TRACKING & ANALYTICS — see Section 4 of the build spec
    Placement below matches the spec's "Target Code Placement" column.
    Fields the client left blank are stubbed here so IDs can be
    dropped straight in later without hunting for where they go.
    ================================================================
  -->

  <!-- Google Tag Manager -->
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-PGVQM8SP');</script>
  <!-- End Google Tag Manager -->

  <!-- Google Analytics (GA4) — G-XXXXXXXXXX not provided yet
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
  <script is:inline>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','G-XXXXXXXXXX');</script>
  -->

  <!-- Google Search Console verification (HTML tag method) — alternative: DNS TXT record
  <meta name="google-site-verification" content="REPLACE_ME" />
  -->

  <!-- Meta Pixel Code -->
  <script is:inline>
  !function(f,b,e,v,n,t,s)
  {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
  n.callMethod.apply(n,arguments):n.queue.push(arguments)};
  if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
  n.queue=[];t=b.createElement(e);t.async=!0;
  t.src=v;s=b.getElementsByTagName(e)[0];
  s.parentNode.insertBefore(t,s)}(window, document,'script',
  'https://connect.facebook.net/en_US/fbevents.js');
  // One visitor id (32 random bytes, hex) kept for two years, and one id per
  // page view. The pixel and /api/pageview send the same ids, so Meta pairs
  // the browser and server PageView and counts the view once.
  var lpVid = (function () {
    try {
      var m = document.cookie.match(/(?:^|; )lp_vid=([a-f0-9]{64})/);
      if (m) return m[1];
      var b = new Uint8Array(32);
      crypto.getRandomValues(b);
      var v = Array.prototype.map.call(b, function (x) { return ('0' + x.toString(16)).slice(-2); }).join('');
      document.cookie = 'lp_vid=' + v + '; Max-Age=63072000; Path=/; SameSite=Lax; Secure';
      return v;
    } catch (e) {
      return '';
    }
  })();
  window.__lpVid = lpVid;
  var lpPvId = window.crypto && crypto.randomUUID
    ? crypto.randomUUID()
    : Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 12);
  fbq('init', '2302599970275699', lpVid ? { external_id: lpVid } : {});
  fbq('track', 'PageView', {}, { eventID: lpPvId });
  (function () {
    var sent = false;
    function ck(n) {
      var m = document.cookie.match(new RegExp('(?:^|; )' + n + '=([^;]*)'));
      return m ? decodeURIComponent(m[1]) : '';
    }
    function send() {
      if (sent) return;
      sent = true;
      var fbclid = new URLSearchParams(location.search).get('fbclid');
      var body = JSON.stringify({
        event_id: lpPvId,
        page_url: location.href,
        visitor_id: lpVid,
        fbp: ck('_fbp'),
        fbc: ck('_fbc') || (fbclid ? 'fb.1.' + Date.now() + '.' + fbclid : ''),
      });
      try {
        if (navigator.sendBeacon && navigator.sendBeacon('/api/pageview', new Blob([body], { type: 'text/plain' }))) return;
      } catch (e) {}
      try {
        fetch('/api/pageview', { method: 'POST', body: body, keepalive: true, headers: { 'Content-Type': 'text/plain' } });
      } catch (e) {}
    }
    // _fbp is written once fbevents.js loads; give it up to 3 seconds.
    var tries = 0;
    (function wait() {
      if (ck('_fbp') || ++tries > 15) return send();
      setTimeout(wait, 200);
    })();
    addEventListener('pagehide', send);
  })();
  </script>
  <noscript><img height="1" width="1" style="display:none"
  src="https://www.facebook.com/tr?id=2302599970275699&ev=PageView&noscript=1"
  /></noscript>
  <!-- End Meta Pixel Code -->

  <!--
    NOTE ON THE META CONVERSIONS API (CAPI):
    The build spec included a CAPI access token. That token is a
    server-side secret — it must never be shipped in client/static
    code (this repo is fully static and this file is public in the
    browser). It has intentionally NOT been placed anywhere in this
    project. When the CRM integration is built, store it as an
    encrypted Cloudflare Pages environment variable and call the
    Conversions API from a server-side function, never from the
    browser. See the README for details.
  -->

  <!-- Cloudflare Turnstile — explicit rendering so each of the three form
       instances gets its own widget and the popup's can be rendered only
       once the popup is actually visible. Site key lives in
       src/scripts/interactions.js. -->
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?onload=onloadTurnstileCallback&render=explicit" async defer></script>

</head>
<body>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PGVQM8SP"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->
  <slot />

  <!-- CallRail Dynamic Number Insertion: immediately before </body>, per CallRail's install guide -->
  <script is:inline type="text/javascript" src="//cdn.callrail.com/companies/514974372/23e9803bf1d2dc4300ce/12/swap.js"></script>
  <!-- End CallRail -->
</body>
</html>
