---
import { Image } from 'astro:assets';
import heroImage from '../assets/hero.jpeg';
import LeadForm from './LeadForm.astro';
import TrustLine from './TrustLine.astro';

interface Props {
  badge: string;
  headline: string;
  subheading: string;
  ctaLabel: string;
}

const { badge, headline, subheading, ctaLabel } = Astro.props;
---

<section class="hero">
  <!-- Decorative: the headline already carries the message, so alt is empty.
       eager + high priority because this is the LCP element on a paid-traffic
       page, and Astro emits a responsive srcset so phones do not pull the
       full-width file. -->
  <Image
    class="hero-bg"
    src={heroImage}
    alt=""
    widths={[640, 960, 1280, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero-scrim"></div>

  <div class="hero-inner">
    <div>
      <div class="badge"><span class="badge-dot"></span>{badge}</div>
      <h1>{headline}</h1>
      <p class="hero-sub">{subheading}</p>
      <button class="btn" type="button" data-open-popup>{ctaLabel}</button>
      <TrustLine />
    </div>

    <div class="glass-card fc">
      <LeadForm variant="hero" />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--bg-2);
    border-bottom: 1px solid var(--border);
    padding: 76px var(--pad) 68px;
  }

  /* Photo sits at the very back; everything else stacks above it with an
     explicit z-index so the order never depends on pseudo-element quirks. */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Without this the white headline sits on a bright sky and is unreadable.
     Heavier on the left where the copy is, lighter on the right so the photo
     still reads behind the form. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        90deg,
        rgba(3, 7, 18, 0.95) 0%,
        rgba(3, 7, 18, 0.88) 38%,
        rgba(3, 7, 18, 0.62) 72%,
        rgba(3, 7, 18, 0.55) 100%
      ),
      linear-gradient(
        180deg,
        rgba(3, 7, 18, 0.55) 0%,
        rgba(3, 7, 18, 0.15) 40%,
        rgba(3, 7, 18, 0.7) 100%
      );
  }
  /* ambient depth: soft blue glow + a faint vignette toward the edges */
  .hero::before {
    content: '';
    position: absolute;
    top: -220px;
    right: -160px;
    width: 700px;
    height: 700px;
    background: radial-gradient(circle, rgba(0, 144, 224, 0.10) 0%, transparent 65%);
    pointer-events: none;
    z-index: 2;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 40%, transparent 55%, rgba(0, 0, 0, 0.35) 100%);
    pointer-events: none;
    z-index: 2;
  }
  .hero-inner {
    max-width: 1140px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: 60px;
    align-items: start;
    position: relative;
    z-index: 3;
  }
  .hero-sub {
    font-size: 1rem;
    color: var(--muted-2);
    line-height: 1.75;
    margin-bottom: 30px;
    max-width: 30rem;
  }
  .fc { padding: 26px; }
  @media (max-width: 960px) {
    .hero-inner { grid-template-columns: 1fr; }
    /* Stacked layout puts copy over the whole width, so the scrim goes
       flat and darker instead of fading to the right. */
    .hero-scrim {
      background: linear-gradient(
        180deg,
        rgba(3, 7, 18, 0.92) 0%,
        rgba(3, 7, 18, 0.86) 55%,
        rgba(3, 7, 18, 0.94) 100%
      );
    }
  }
</style>
