---
interface Props {
  eyebrow: string;
  heading: string;
  before: string[];
  statNum: string;
  statLabel: string;
  after: string[];
}

const { eyebrow, heading, before, statNum, statLabel, after } = Astro.props;
---

<div class="prob-wrap">
  <div class="prob">
    <div class="eyebrow">{eyebrow}</div>
    <h2>{heading}</h2>
    {before.map((p) => <p class="pp" set:html={p} />)}
    <div class="pstat">
      <div class="pn">{statNum}</div>
      <div class="pl">{statLabel}</div>
    </div>
    {after.map((p) => <p class="pp" set:html={p} />)}
  </div>
</div>

<style>
  .prob-wrap { background: var(--bg-2); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .prob { max-width: 44rem; margin: 0 auto; padding: 76px var(--pad); text-align: center; }
  .prob h2 { text-align: center; margin-bottom: 20px; }
  .pp { font-size: 1.05rem; line-height: 1.85; color: var(--muted-2); margin: 0 auto 18px; max-width: none; }
  .pp :global(strong) { color: #fff; font-weight: 600; }
  .pstat {
    display: inline-block;
    background: var(--card);
    border: 1px solid var(--accent-border);
    border-radius: var(--radius-lg);
    padding: 26px 48px;
    margin: 8px 0 22px;
  }
  .pn { font-family: var(--font-head); font-size: 3.5rem; font-weight: 800; color: var(--accent); line-height: 1; letter-spacing: -0.03em; }
  .pl { font-size: 0.85rem; color: var(--muted); margin-top: 7px; }
</style>
