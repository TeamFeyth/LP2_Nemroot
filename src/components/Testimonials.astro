---
// Section 5 / Testimonials — quotes verbatim from the spec.
// LP1 and LP2 carry slightly different wording for testimonial 3 per the spec,
// so the quotes are passed in rather than hardcoded.
interface Testimonial { quote: string; name: string; role: string }
interface Props {
  eyebrow: string;
  heading: string;
  testimonials: Testimonial[];
}
const { eyebrow, heading, testimonials } = Astro.props;
---

<div class="wrap">
  <div class="eyebrow">{eyebrow}</div>
  <h2>{heading}</h2>
  <div class="testis">
    {testimonials.map((t) => (
      <div class="card testi">
        <div class="stars" aria-label="5 out of 5 stars">★★★★★</div>
        <p class="tq">"{t.quote}"</p>
        <div class="tname">{t.name}</div>
        <div class="trole">{t.role}</div>
      </div>
    ))}
  </div>
</div>

<style>
  .wrap { padding: 76px var(--pad); max-width: var(--container); margin: 0 auto; }
  .testis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 40px; }
  .stars { color: var(--accent); font-size: 0.75rem; margin-bottom: 12px; letter-spacing: 2px; }
  .tq { font-size: 0.85rem; color: var(--muted-2); line-height: 1.75; margin-bottom: 16px; max-width: none; }
  .tname { font-size: 0.82rem; font-weight: 700; color: #fff; }
  .trole { font-size: 0.75rem; color: var(--muted); }

  @media (max-width: 960px) { .testis { grid-template-columns: 1fr; } }
</style>
