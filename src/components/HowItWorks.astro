---
const steps = [
  { title: 'Lead arrives', body: 'From any channel — website, SMS, Facebook, email, phone. Captured instantly, nothing missed.' },
  { title: 'Nemroot responds', body: 'The AI replies within 14 seconds, day or night. It knows your live inventory and qualifies the lead in the same message.' },
  { title: 'Appointment booked', body: 'Follow-up runs automatically until the customer confirms a test drive. Leads that go quiet get pulled back in without anyone on your team touching it.' },
  { title: 'Your team closes', body: 'Full context handed off to your salesperson. No lead left behind. Deal gets done.' },
];
---

<div class="wrap">
  <div class="eyebrow">How It Works</div>
  <h2>From lead to appointment, without lifting a finger.</h2>
  <div class="steps">
    {steps.map((s, i) => (
      <div class="card step">
        <div class="snum">{i + 1}</div>
        <div class="stitle">{s.title}</div>
        <div class="sbody">{s.body}</div>
      </div>
    ))}
  </div>
</div>

<style>
  .wrap { padding: 76px var(--pad); max-width: var(--container); margin: 0 auto; }
  .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: 40px; }
  .step { position: relative; overflow: hidden; }
  .step::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--accent) 0%, transparent 100%);
  }
  .snum {
    width: 32px; height: 32px;
    background: var(--accent-glow);
    border: 1px solid var(--accent-border);
    border-radius: 9px;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-head);
    font-size: 0.8rem; font-weight: 700; color: var(--accent);
    margin-bottom: 16px;
  }
  .stitle { font-size: 0.95rem; font-weight: 700; color: #fff; margin-bottom: 7px; }
  .sbody { font-size: 0.82rem; color: var(--muted); line-height: 1.65; }

  @media (max-width: 960px) {
    .steps { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 640px) {
    .steps { grid-template-columns: 1fr; }
  }
</style>
