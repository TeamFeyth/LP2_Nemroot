---
interface Props {
  eyebrow: string;
  heading: string;
  subcopy: string;
}
const { eyebrow, heading, subcopy } = Astro.props;

const features = [
  {
    title: '14-second average response time',
    body: 'Every lead answered before the competition even sees the notification.',
    path: 'M13 2 4 14h6l-1 8 9-12h-6l1-8z',
  },
  {
    title: 'One inbox for everything',
    body: 'SMS, Facebook, email, web chat, and phone calls in one place.',
    path: 'M3 10h5l2 3h4l2-3h5 M3 9.5l1.6-4A2 2 0 0 1 6.5 4h11a2 2 0 0 1 1.9 1.5l1.6 4V19a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z',
  },
  {
    title: 'Inventory-aware AI',
    body: 'When a customer asks about the white F-150 with a tow package under $45k, the AI already knows if you have it.',
    path: 'M3 13l1.5-4.5A2 2 0 0 1 6.4 7h11.2a2 2 0 0 1 1.9 1.5L21 13v4a1 1 0 0 1-1 1h-1a1 1 0 0 1-1-1v-1H6v1a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z M7.5 19a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z M16.5 19a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z',
  },
  {
    title: 'Automatic follow-up',
    body: 'Leads that go quiet get reactivated. No manual work, no forgotten prospects.',
    path: 'M21 12a9 9 0 1 1-3-6.7 M21 3v6h-6',
  },
  {
    title: '24/7, weekends, after hours',
    body: "The AI doesn't take days off.",
    path: 'M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z',
  },
  {
    title: 'Live in 24 to 48 hours',
    body: 'Not months of onboarding. Two days.',
    path: 'M22 11.08V12a10 10 0 1 1-5.93-9.14 M22 4 12 14.01 9 11.01',
  },
];
---

<div class="section-alt">
  <div class="wrap">
    <div class="eyebrow">{eyebrow}</div>
    <h2>{heading}</h2>
    <p class="section-sub">{subcopy}</p>
    <div class="feats">
      {features.map((f) => (
        <div class="card feat">
          <svg class="ficon" viewBox="0 0 24 24" aria-hidden="true"><path d={f.path} /></svg>
          <div class="ftitle">{f.title}</div>
          <div class="fbody">{f.body}</div>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .wrap { padding: 76px var(--pad); max-width: var(--container); margin: 0 auto; }
  .feats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 40px; }
  .feat { transition: border-color .2s; }
  .feat:hover { border-color: var(--accent-border); }
  .ficon {
    width: 22px; height: 22px;
    margin-bottom: 14px;
    stroke: var(--accent);
    fill: none;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ftitle { font-size: 0.95rem; font-weight: 700; color: #fff; margin-bottom: 7px; }
  .fbody { font-size: 0.82rem; color: var(--muted); line-height: 1.65; }

  @media (max-width: 960px) {
    .feats { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 640px) {
    .feats { grid-template-columns: 1fr; }
  }
</style>
