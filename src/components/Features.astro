---
// Section 5 / "Why Dealers Choose Nemroot" — eyebrow, heading, subcopy and the
// six bullets are reproduced VERBATIM from the spec (Section 5 of the build doc).
// The spec supplies each bullet as a single flat string, so each card renders
// that string as-is with no invented title. Emoji icons follow the HTML drafts.
interface Props {
  eyebrow: string;
  heading: string;
  subcopy: string;
  bullets: string[];
}
const { eyebrow, heading, subcopy, bullets } = Astro.props;

const icons = ['⚡', '📥', '🚗', '🔄', '🕐', '✅'];
---

<div class="section-alt">
  <div class="wrap">
    <div class="eyebrow">{eyebrow}</div>
    <h2>{heading}</h2>
    <p class="section-sub">{subcopy}</p>
    <div class="feats">
      {bullets.map((b, i) => (
        <div class="card feat">
          <div class="ficon" aria-hidden="true">{icons[i % icons.length]}</div>
          <div class="fbody">{b}</div>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .wrap { padding: 76px var(--pad); max-width: var(--container); margin: 0 auto; }
  .feats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 40px; }
  .feat { transition: border-color .2s; }
  .feat:hover { border-color: var(--accent-border); }
  .ficon { font-size: 1.25rem; line-height: 1; margin-bottom: 14px; }
  .fbody { font-size: 0.88rem; color: var(--muted-2); line-height: 1.7; }

  @media (max-width: 960px) { .feats { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .feats { grid-template-columns: 1fr; } }
</style>
