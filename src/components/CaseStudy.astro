---
// Spec 5 / 5. Case Study Section (unique to LP2) — eyebrow, heading, body,
// callout and button text all verbatim from the build spec.
---

<div class="cs">
  <div class="cs-inner">
    <div class="eyebrow">Case Study</div>
    <h2 style="text-align:center">Enhancing the quality of service at Kayalar Motors</h2>
    <p class="cs-p">Kayalar Motors, a luxury dealership in Houston, was having trouble keeping up with their leads. As salespeople got tied up with other activities, clients on the showroom floor, or receiving messages after hours, they were unable to get to the customer in a timely manner.</p>
    <div class="cs-callout">Expect the same results in 48 hours.</div>
    <div>
      <button class="btn" type="button" data-scroll-to=".sbar">Check the Numbers</button>
    </div>
  </div>
</div>

<style>
  .cs { background: var(--bg); border-bottom: 1px solid var(--border); }
  .cs-inner { max-width: 47rem; margin: 0 auto; padding: 80px var(--pad); text-align: center; }
  .cs-p { font-size: 1.05rem; line-height: 1.85; color: var(--muted-2); margin: 0 auto 20px; max-width: none; }
  .cs-callout {
    display: inline-block;
    background: var(--card);
    border: 1px solid var(--accent-border);
    border-radius: var(--radius-lg);
    padding: 20px 32px;
    margin: 4px 0 28px;
    font-size: 0.95rem;
    color: var(--accent);
    font-weight: 600;
    line-height: 1.7;
  }
</style>
